<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Foreground service (connectedDevice type): required to run the persistent sync service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Runtime permission on API 33+ so the persistent sync notification is visible. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Qualifying permission for the connectedDevice FGS type on API 34+ (lets the service start
         from the background without a runtime Bluetooth permission prompt). Normal permission —
         granted automatically at install time. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <application
        android:name=".MonologueApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Monologueorbitalcompanion">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Monologueorbitalcompanion"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Background sync keeps running while alarm or calendar syncing is enabled. -->
        <service
            android:name=".SyncService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>

</manifest>