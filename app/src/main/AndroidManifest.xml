<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Foreground service (connectedDevice type): required to run the persistent sync service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Runtime permission on API 33+ so the persistent sync notification is visible. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Qualifying permission for the connectedDevice FGS type on API 34+ (lets the service start
         from the background without a runtime Bluetooth permission prompt). Normal permission —
         granted automatically at install time. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <application
        android:name=".MonologueApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Monologueorbitalcompanion">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Monologueorbitalcompanion"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Background sync keeps running while alarm or calendar syncing is enabled. -->
        <service
            android:name=".SyncService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Reads timer notifications from the system clock apps to power Timer sync (message key
             113). Requires the user to enable notification access for this app. -->
        <service
            android:name=".ClockTimerNotificationListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Quick Settings tile that toggles the master sync gate. Exported (mandatory) and
             guarded by BIND_QUICK_SETTINGS_TILE so only the SystemUI can bind it. -->
        <service
            android:name=".MasterSyncTileService"
            android:exported="true"
            android:icon="@drawable/ic_quick_settings_sync"
            android:label="@string/tile_master_sync_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>